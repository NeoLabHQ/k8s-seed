# Seed parameters for one cluster. Copy to `.env` and fill in.
# `just bootstrap` loads this file; anything missing fails the render before the
# cluster is touched.

# ---------------------------------------------------------------------------------------------------------------------
# TOPOLOGY
# ---------------------------------------------------------------------------------------------------------------------

# The only value that differs between clusters. Selects clusters/<name>/ in the
# gitops repository, e.g. master, dev, staging, acme-prod.
TARGET_CLUSTER_NAME=

# ---------------------------------------------------------------------------------------------------------------------
# GITOPS REPOSITORY
# ---------------------------------------------------------------------------------------------------------------------

GITOPS_REPO_URL=
# Optional; defaults to `master`.
GITOPS_TARGET_REVISION=master
# Git credential Argo CD reads the repository with. For a GitHub token the
# username is your account name or a deploy-token name; the password is the token.
GITOPS_REPO_USERNAME=
GITOPS_REPO_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------------
# ARGO CD
# ---------------------------------------------------------------------------------------------------------------------

# Hostname Argo CD will answer on once the gitops repository delivers ingress.
# Also the SSO redirect host, so it must match the OAuth App callback below.
ARGO_HOST=

# OIDC client for the Argo CD UI. Today this is the GitHub OAuth App registered
# for this cluster, with callback https://${ARGO_HOST}/api/dex/callback.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional. GitHub organisation allowed to sign in, e.g. acme-inc. Leave empty
# and any GitHub account can reach the Argo CD login — they get no permissions,
# because default RBAC grants none, but set this to keep the door narrower.
# Only applies while the bundled Dex is the issuer.
GITHUB_ORG=

# Leave empty to use the Dex bundled in the argo-cd chart as the issuer.
# Set it to point at a central Dex broker instead; the bundled Dex then stays off
# and OIDC_CLIENT_ID/SECRET become that broker's client credentials.
OIDC_ISSUER_URL=

# Seed parameters for one cluster. Copy to `.env` and fill in.
# `just bootstrap` loads this file; anything missing fails the render before the
# cluster is touched.

# ---------------------------------------------------------------------------------------------------------------------
# TOPOLOGY
# ---------------------------------------------------------------------------------------------------------------------

# The only value that differs between clusters. Selects clusters/<name>/ in the
# gitops repository, e.g. master, dev, staging, acme-prod.
TARGET_CLUSTER_NAME=

# ---------------------------------------------------------------------------------------------------------------------
# GITOPS REPOSITORY
# ---------------------------------------------------------------------------------------------------------------------

GITOPS_REPO_URL=
# Optional; defaults to `master`.
GITOPS_TARGET_REVISION=master
# Git credential Argo CD reads the repository with, per
# https://argo-cd.readthedocs.io/en/stable/user-guide/private-repositories/ —
# any non-empty string works as the username when the password is a token.
GITOPS_REPO_USERNAME=
# GitHub personal access token with read access to the gitops repo (`repo`
# scope, or fine-grained Contents: Read-only). Generate one under
# https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens
GITOPS_REPO_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------------
# ARGO CD
# ---------------------------------------------------------------------------------------------------------------------

# Hostname Argo CD will answer on once the gitops repository delivers ingress.
# Also the SSO redirect host, so it must match the OAuth App callback below.
# This is a hostname you own DNS for, not issued by Argo CD or GitHub; it maps
# to `global.domain` in the argo-cd chart —
# https://github.com/argoproj/argo-helm/blob/main/charts/argo-cd/values.yaml
ARGO_HOST=

# OIDC client for the Argo CD UI. Today this is the GitHub OAuth App registered
# for this cluster, with callback https://${ARGO_HOST}/api/dex/callback.
# Register the app under GitHub Settings > Developer settings > OAuth Apps
# (https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app),
# setting Authorization callback URL to the value above. OIDC_CLIENT_ID is
# shown on the app's page once created; click "Generate a new client secret"
# to get OIDC_CLIENT_SECRET.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional. GitHub organisation allowed to sign in, e.g. acme-inc — the org's
# slug as it appears in https://github.com/<org>. Leave empty and any GitHub
# account can reach the Argo CD login — they get no permissions, because
# default RBAC grants none, but set this to keep the door narrower. Becomes
# the `orgs` entry of the Dex GitHub connector — see
# https://argo-cd.readthedocs.io/en/stable/operator-manual/user-management/
# Only applies while the bundled Dex is the issuer.
GITHUB_ORG=

# Leave empty to use the Dex bundled in the argo-cd chart as the issuer, per
# https://argo-cd.readthedocs.io/en/stable/operator-manual/user-management/
# Set it to point at a central Dex broker instead; the bundled Dex then stays off
# and OIDC_CLIENT_ID/SECRET become that broker's client credentials.
OIDC_ISSUER_URL=

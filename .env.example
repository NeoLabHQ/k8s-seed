# Seed parameters for one cluster. Copy to `.env` and fill in.
# `just bootstrap` loads this file; anything missing fails the render before the
# cluster is touched.

# ---------------------------------------------------------------------------------------------------------------------
# TOPOLOGY
# ---------------------------------------------------------------------------------------------------------------------

# The only value that differs between clusters. Selects
# generated/clusters/<name>/ in the gitops repository, e.g. master, dev,
# staging, acme-prod. That directory is written by the gitops repository's
# generator, not by hand.
TARGET_CLUSTER_NAME=local

# ---------------------------------------------------------------------------------------------------------------------
# GITOPS REPOSITORY
# ---------------------------------------------------------------------------------------------------------------------

# HTTPS clone URL of the gitops repository, e.g. https://github.com/acme/gitops.
# HTTPS and not SSH: the credential below is a GitHub App, which authenticates
# git over HTTP.
GITOPS_REPO_URL=https://github.com/NeoLabHQ/gitops
# Optional; defaults to `master`.
GITOPS_TARGET_REVISION=master

# Argo CD reads the repository as a GitHub App. See "Register the GitHub App"
# in docs/how-to-launch-cluster.md for how to register it, which permission it
# needs, and where to find the two IDs below. This is the identity Argo CD
# itself clones with, and the only GitHub registration this seed asks for: the
# seed configures no SSO, so there is no OAuth App to confuse it with.

# The app's numeric App ID, from the app's settings page. Not the Client ID
# shown beside it, which is a different, non-numeric value; pasting it here
# yields a Secret Argo CD cannot authenticate with, so bootstrap refuses
# anything that is not all digits.
GITOPS_REPO_GITHUB_APP_ID=

# The numeric ID of *this installation* of the app — a different object from
# the app, with a different ID. Read it off the installation's settings URL,
# https://github.com/organizations/<org>/settings/installations/<id>.
GITOPS_REPO_GITHUB_APP_INSTALLATION_ID=

# Path to the app's private key file — the path, not the key. Generate it on
# the app's own settings page, under Private keys > Generate a private key.
# Give an absolute path outside this repository, e.g.
# /home/you/.secrets/acme-gitops-app.pem. It is read by a shell, not expanded by
# one, so `~` is a literal character here and will not resolve to your home
# directory.
GITOPS_REPO_GITHUB_APP_PRIVATE_KEY_PATH=

# ---------------------------------------------------------------------------------------------------------------------
# ARGO CD
# ---------------------------------------------------------------------------------------------------------------------

# Hostname Argo CD will answer on once the gitops repository delivers ingress.
# This is a hostname you own DNS for, not issued by Argo CD or GitHub; it maps
# to `global.domain` in the argo-cd chart —
# https://github.com/argoproj/argo-helm/blob/main/charts/argo-cd/values.yaml
ARGO_HOST=argocd.localhost

# There is deliberately no SSO setting in this file. The seed installs an
# admin-account-only Argo CD, and the gitops repository owns 100% of SSO: the
# issuer, the client credentials, and the RBAC that decides what a signed-in
# user may do. SSO could not work at bootstrap in any case — the redirect URI
# is built from ARGO_HOST, which resolves to nothing until the gitops
# repository has delivered ingress and DNS. Until it does, log in as `admin`
# with the password from `just argo-password`. See "Authentication" in
# README.md.

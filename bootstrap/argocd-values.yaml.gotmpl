# Argo CD chart values for the bootstrap seed.
#
# These values are the contract with the gitops repository. When the gitops repo
# takes over managing Argo CD, its Application must install the same chart
# version with the same values, or the Helm release and Argo CD will fight over
# the same resources. See docs/gitops-repo.md.

global:
  # Drives the Argo CD external URL and any ingress the gitops repository later
  # adds. It is also the host an SSO redirect URI is built from once the gitops
  # repository configures SSO — which the seed never does; see below.
  domain: {{ .Values.argoHost | quote }}

  additionalLabels:
    # Which cluster this Argo CD is the control plane for. The only per-cluster
    # value in the seed; everything else here is environment configuration.
    # Quoted: a purely numeric cluster name must still be a string label.
    k8s-seed/cluster: {{ .Values.clusterName | quote }}

configs:
  params:
    # TLS is terminated in front of Argo CD by the ingress controller the gitops
    # repository installs. Until it exists, `just argo-ui` port-forwards plain
    # HTTP. Without this, argocd-server serves its own self-signed certificate
    # and redirects :80 to :443.
    server.insecure: true

  # No `cm.oidc.config`, no `cm.dex.config`, no `secret.extra` OIDC credentials
  # and no `rbac:` key here, deliberately. The seed installs an
  # admin-account-only Argo CD; the gitops repository owns 100% of SSO, both the
  # issuer and the authorisation that follows it.
  #
  # This is not deferral of work the seed could do. SSO cannot function at
  # bootstrap in the first place: the redirect URI is built from the hostname
  # above, which resolves to nothing until the gitops repository has delivered
  # ingress, DNS and certificates, and where a central broker is the issuer,
  # that broker is itself a gitops workload whose client secret arrives with it.
  # The initial admin account is the way in until then — `just argo-password`.
  #
  # Seeding it was also actively harmful, which is why this is a hard rule
  # rather than a preference. Argo CD three-way merges argocd-cm and prunes only
  # the keys its own Application declares, so a `dex.config` written here is
  # absent from that Application's last-applied-configuration and survives the
  # handoff. A cluster then carries a seeded `dex.config` alongside the gitops
  # repository's `oidc.config`, and the two disagree: login follows `oidc.config`
  # and succeeds, while per-request session-token verification follows the
  # bundled Dex and fails, so users sign in and land back on the login page. One
  # ConfigMap key with two owners is the whole fault — the split rule in
  # docs/gitops-repo.md exists to prevent exactly this.

# LOAD-BEARING. Not redundant tidiness, and not safe to delete as "already the
# default": the argo-cd chart defaults dex.enabled to *true*, so removing this
# block installs the bundled Dex on every seeded cluster — the exact object the
# comment above exists to keep off them. Unconditional, because there is no
# longer any input that could legitimately turn it back on.
dex:
  enabled: false
